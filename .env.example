# ============================================================
# W3Labs WillIAn — Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha com suas chaves reais.
# NUNCA envie o .env para o repositório!
# ============================================================

# Configurações do Firebase
VITE_FIREBASE_API_KEY=SUA_FIREBASE_API_KEY_AQUI
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=SEU_SENDER_ID
VITE_FIREBASE_APP_ID=1:SEU_SENDER_ID:web:SEU_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=G-SEU_MEASUREMENT_ID

# Configurações do Gemini (Google AI Studio ou Vertex AI Express)
# Obtenha em: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=SUA_GEMINI_API_KEY_AQUI
VITE_GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
VITE_GEMINI_MODEL=gemini-2.5-flash

# Configurações do UnoRouter (Endpoint compatível com OpenAI — modelos :free)
# Obtenha em: https://unorouter.com
VITE_UNOROUTER_BASE_URL=https://api.unorouter.com/v1
VITE_UNOROUTER_API_KEY=SUA_UNOROUTER_API_KEY_AQUI

# Porta do servidor (padrão: 4145)
PORT=4145
